# 서비스와 수동 실행에서 source하여 사용하는 차량 공통 설정.
UPLOADER_SERVER_URL=https://192.168.2.1:8000
UPLOADER_CA_FILE=/etc/ace/certs/ace-ca.crt
# 비우면 기존 $HOME/uploader/data/queue.db 및 jobs 경로를 사용한다.
UPLOADER_DB_PATH=
UPLOADER_SPOOL_ROOT=
UPLOADER_MIN_FREE_BYTES=536870912
UPLOADER_LOG_VIEW=

# 호스트네임으로 시뮬레이션 서버의 등록 차량과 API 키를 선택한다.
case "$(hostname -s)" in
    craft2)
        UPLOADER_NODE_ID=NODE_PI_02_TEST
        UPLOADER_VEHICLE_ID=CAR_02
        UPLOADER_API_KEY=ace_ppsvYnZC3T30szmHpGcFB_JSrapDQoPYvaJrYTGlH7U
        ;;
    craft3)
        UPLOADER_NODE_ID=NODE_PI_03_TEST
        UPLOADER_VEHICLE_ID=CAR_03
        UPLOADER_API_KEY=ace_xf01KgU1i5K50Z6mw0IjksPUovNU_P4uGeBgawSlXI4
        ;;
    craft4)
        UPLOADER_NODE_ID=NODE_PI_04_TEST
        UPLOADER_VEHICLE_ID=CAR_04
        UPLOADER_API_KEY=ace_2HuKf9eIHGrCZy7FzM7LwD9CRiO792DoyWjKIx8zZpc
        ;;
    seongugi|craft5)
        UPLOADER_NODE_ID=NODE_PI_05_TEST
        UPLOADER_VEHICLE_ID=CAR_05
        UPLOADER_API_KEY=ace_VddlxjP-NOTu_18_kzqSz2ClVH3P2Ym7xnXXGPIMwrw
        ;;
    craft6)
        UPLOADER_NODE_ID=NODE_PI_06_TEST
        UPLOADER_VEHICLE_ID=CAR_06
        UPLOADER_API_KEY=ace_yG4ZeHrDtIRMBNjrMCkx_Uogdq70NPLBX74tLHQyoAA
        ;;
    *)
        unset UPLOADER_NODE_ID UPLOADER_VEHICLE_ID UPLOADER_API_KEY
        echo "Uploader 차량 설정 없음: $(hostname -s)" >&2
        return 1
        ;;
esac

export UPLOADER_SERVER_URL UPLOADER_CA_FILE UPLOADER_DB_PATH UPLOADER_SPOOL_ROOT
export UPLOADER_MIN_FREE_BYTES UPLOADER_LOG_VIEW
export UPLOADER_NODE_ID UPLOADER_VEHICLE_ID UPLOADER_API_KEY
