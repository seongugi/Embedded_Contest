[Unit]
Description=ACE Wi-Fi Direct group owner and P2P sender
Wants=NetworkManager.service
After=NetworkManager.service p2p-client.service
Conflicts=p2p-client.service
StartLimitIntervalSec=0

[Service]
Type=notify
NotifyAccess=main
WatchdogSec=15s
TimeoutStartSec=infinity
User=root
Group=root
WorkingDirectory=@EXEC_ROOT@
ExecStart=/bin/bash @EXEC_ROOT@/p2p_go.sh
Environment=ACE_P2P_SYSTEMD=1
Restart=always
RestartSec=5s
TimeoutStopSec=20s
KillSignal=SIGTERM
KillMode=control-group
PrivateTmp=false
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
